<?xml version="1.0" encoding="utf-8"?>
<!--
    底栏玻璃：与顶栏同一套材质，高光线位于朝向列表的上缘。
    主界面采用非叠加布局，底栏只透出窗口背景，不承接滚动内容。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/glass_bar_top"
                android:startColor="@color/glass_bar_bottom" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>

    <item
        android:gravity="top"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_highlight" />
        </shape>
    </item>

</layer-list>
