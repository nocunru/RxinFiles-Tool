<?xml version="1.0" encoding="utf-8"?>
<!--
    卡片玻璃：16dp 圆角 + 顶部 1dp 高光。

    用于「浮在背景之上、需要一点实体感」的块 —— 如加载页卡片、空态卡片。
    刻意不做投影：投影交给调用处的 elevation，材质只负责「表面」，
    两处都管阴影的话很容易叠出脏边。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/glass_fill_bottom"
                android:startColor="@color/glass_fill_top" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>

    <item
        android:gravity="top"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_highlight" />
            <corners
                android:topLeftRadius="16dp"
                android:topRightRadius="16dp" />
        </shape>
    </item>

</layer-list>
