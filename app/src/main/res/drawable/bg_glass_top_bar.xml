<?xml version="1.0" encoding="utf-8"?>
<!--
    顶栏玻璃：上实下虚的填充（上 12%~90% → 下 6%~75%）+ 1dp 描边 + 底缘高光线。

    「底缘一道细高光」是玻璃压在内容上方时最像真玻璃的一处细节 ——
    它模拟光线在玻璃下边缘的折射堆积。没有它，半透明面板看起来只是「有点透的色块」。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/glass_bar_bottom"
                android:startColor="@color/glass_bar_top" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>

    <item
        android:gravity="bottom"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_highlight" />
        </shape>
    </item>

</layer-list>
