<?xml version="1.0" encoding="utf-8"?>
<!--
    横屏/矮屏主界面：只保留路径、快捷操作、文件列表和底部导航。
    展示型标题与「当前目录」说明整节移除，列表拿到尽可能多的剩余高度。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_glass_card"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="5dp">

        <ImageButton
            android:id="@+id/upBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="上级目录"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_upward" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pathText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_chip_ripple"
                android:clickable="true"
                android:ellipsize="start"
                android:focusable="true"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:minHeight="24dp"
                android:paddingHorizontal="10dp"
                android:text="/storage/emulated/0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/loadingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:ellipsize="marquee"
                android:focusable="true"
                android:gravity="start"
                android:marqueeRepeatLimit="marquee_forever"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:paddingVertical="1dp"
                android:text="RxinFiles-Tool"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/refreshBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="刷新"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_refresh" />

        <ImageButton
            android:id="@+id/moreMenuBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="更多"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/terminalBtn"
            style="@style/QuickActionButton"
            android:layout_height="44dp"
            android:minHeight="44dp"
            android:text="终端"
            android:textSize="11sp"
            app:iconGravity="textStart"
            app:iconPadding="5dp"
            app:iconSize="16dp"
            app:icon="@drawable/ic_terminal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quickBookmarkBtn"
            style="@style/QuickActionButton"
            android:layout_height="44dp"
            android:minHeight="44dp"
            android:text="书签"
            android:textSize="11sp"
            app:backgroundTint="@color/card_surface"
            app:iconGravity="textStart"
            app:iconPadding="5dp"
            app:iconSize="16dp"
            app:icon="@drawable/ic_bookmark" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quickSortBtn"
            style="@style/QuickActionButton"
            android:layout_height="44dp"
            android:minHeight="44dp"
            android:text="排序"
            android:textSize="11sp"
            app:iconGravity="textStart"
            app:iconPadding="5dp"
            app:iconSize="16dp"
            app:icon="@drawable/ic_sort" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp" />

    <TextView
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:letterSpacing="0.04"
        android:lineSpacingExtra="6dp"
        android:text="这里空空如也\n当前目录没有可显示的项目"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_glass_card"
        android:elevation="6dp"
        android:minHeight="56dp">

        <LinearLayout
            android:id="@+id/normalBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navHome"
                style="@style/BottomNavButton"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:text="主目录"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:icon="@drawable/ic_home" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navSdcard"
                style="@style/BottomNavButton"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:text="SDCard"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:icon="@drawable/ic_storage" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navRoot"
                style="@style/BottomNavButton"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:text="根目录"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:icon="@drawable/ic_root" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pasteBtn"
                style="@style/BottomNavButton"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:text="粘贴"
                app:backgroundTint="@color/primary_container"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:icon="@drawable/ic_paste" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/selectionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <TextView
                    android:id="@+id/selCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="✕"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/selCount"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="已选 0 项"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/selAll"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="全选"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/selCopy"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="复制"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/selCut"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="剪切"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/selZip"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="压缩"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/selDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="删除"
                    android:textColor="@color/danger"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/selMore"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="更多⋮"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </FrameLayout>
</LinearLayout>
