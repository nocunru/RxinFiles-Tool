<?xml version="1.0" encoding="utf-8"?>
<!--
    独立文件卡片。默认、选中、定位三种背景由 Adapter 切换，
    水波纹在前景绘制，不覆盖状态资源。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_file_row"
    android:foreground="?selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="74dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/fileIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_glass_icon"
        android:contentDescription="图标"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_folder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/fileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textFontWeight="500"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/fileDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/fileAction"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="操作"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_chevron_right" />
</LinearLayout>
