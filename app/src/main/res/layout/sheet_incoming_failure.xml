<?xml version="1.0" encoding="utf-8"?><!--
    「用其他应用打开」定位失败时的诊断面板。

    这是 BottomSheetDialog 的**自身内容**（不是叠在面板上的第二个窗口）——
    工程铁律：面板里要弹的东西一律画在面板自己身上。在已有面板之上再开
    AlertDialog/第二个窗口，层级顺序在各 ROM 上不一致，真机表现是
    「点了没反应、什么都看不到」（见 SheetDialog.kt 的教训）。

    为什么没有复用 SheetDialog.menu()：它的消息区是一整块不可滚动的 TextView，
    而这里的诊断正文可能很长（URI 原文、逐条候选、搜索记录）——长到一定程度会把
    下方的按钮顶出屏幕。所以正文单独放进可滚动的 NestedScrollView，按钮固定在下方。
    Activity 侧还会给滚动区按屏高限一个高度，确保按钮永远点得到。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:id="@+id/incomingFailTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="未能定位原文件位置"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:text="下面这段说明了这次为什么没定位到。点「复制诊断信息」可整段拷走。"
        android:textSize="12sp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/incomingFailScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/incomingFailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </androidx.core.widget.NestedScrollView>

    <!--
        普通身份下的「装 Shizuku」提示条（3.15.2）。

        为什么单独一条而不是塞进正文：正文是**可复制的诊断文本**（用户要整段拷回来），
        而这里是一个**可点的出路**。混在一起会让「复制诊断信息」把提示也拷走，
        也会让用户在长正文里找不到那个能点的东西。

        默认 gone —— 只在「定位失败 且 当前没有 shell 通道」时由 Activity 显出来
        （判据在 IncomingFile.needsShellHint，按身份分流，不给已有 root/adb 的用户误导）。
    -->
    <LinearLayout
        android:id="@+id/incomingFailShizukuBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_tag_soft"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/incomingFailShizukuText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/incomingFailShizukuBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="40dp"
            android:paddingHorizontal="12dp"
            android:text="去下载 Shizuku"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/incomingFailOpen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="44dp"
            android:paddingHorizontal="12dp"
            android:text="打开副本"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/incomingFailCopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="44dp"
            android:paddingHorizontal="12dp"
            android:text="复制诊断信息"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/incomingFailClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="44dp"
            android:paddingHorizontal="12dp"
            android:text="关闭"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
