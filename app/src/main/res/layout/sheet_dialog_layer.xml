<?xml version="1.0" encoding="utf-8"?><!--
  面板内部的「对话框」：遮罩 + 可滚动的卡片。

  书签面板与压缩包面板用 <include> 共用这一份 —— id 必须保持一致，
  因为 SheetDialog.kt 是照这些 id 取视图的。

  卡片贴顶放：面板本来就贴屏幕底部，键盘弹起来盖住的是下半部分，
  贴顶的卡片才不会被打字时的键盘埋掉。

  卡片包在 NestedScrollView 里、宽度设上限：动作菜单很长、字体放大、
  横屏矮窗口时卡片可滚动且不会在平板上拉成一整条。
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sheetDialogLayer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/dialog_content_max_width"
        app:layout_constraintWidth_min="0dp">

        <LinearLayout
            android:id="@+id/sheetDialogCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/sheetDialogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sheetDialogText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:alpha="0.7"
                android:textSize="12sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/sheetDialogInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/sheetDialogActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/sheetDialogButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="end"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/sheetDialogCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="44dp"
                    android:paddingHorizontal="14dp"
                    android:text="取消"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/sheetDialogOk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="44dp"
                    android:paddingHorizontal="14dp"
                    android:text="确定"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
