<?xml version="1.0" encoding="utf-8"?>
<!--
    首屏按任务分区：品牌、路径、快捷操作、当前目录和主导航。
    所有动态状态仍使用原有 ID；快捷按钮只是既有功能的直接入口。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_brand_mark"
            android:gravity="center"
            android:text="R"
            android:textColor="@color/on_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RxinFiles"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:letterSpacing="0.13"
                android:text="FILE WORKSPACE"
                android:textColor="@color/text_tertiary"
                android:textSize="8sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/moreMenuBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="更多"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_glass_card"
        android:gravity="center_vertical"
        android:minHeight="54dp"
        android:orientation="horizontal"
        android:paddingHorizontal="5dp">

        <ImageButton
            android:id="@+id/upBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="上级目录"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_upward" />

        <TextView
            android:id="@+id/pathText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_chip_ripple"
            android:clickable="true"
            android:ellipsize="start"
            android:focusable="true"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:minHeight="42dp"
            android:paddingHorizontal="12dp"
            android:text="/storage/emulated/0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/refreshBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="刷新"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp">

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:ellipsize="marquee"
            android:focusable="true"
            android:gravity="start"
            android:letterSpacing="0.03"
            android:marqueeRepeatLimit="marquee_forever"
            android:maxLines="1"
            android:paddingVertical="3dp"
            android:text="RxinFiles-Tool"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="文件管理"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="浏览、管理与执行，一切井然有序。"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="15dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/terminalBtn"
            style="@style/QuickActionButton"
            android:text="终端"
            app:icon="@drawable/ic_terminal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quickBookmarkBtn"
            style="@style/QuickActionButton"
            android:text="书签"
            app:backgroundTint="@color/card_surface"
            app:icon="@drawable/ic_bookmark" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quickSortBtn"
            style="@style/QuickActionButton"
            android:text="排序"
            app:icon="@drawable/ic_sort" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="17dp"
        android:paddingBottom="7dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="当前目录"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="长按文件可打开更多操作"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:letterSpacing="0.04"
        android:lineSpacingExtra="8dp"
        android:text="这里空空如也\n当前目录没有可显示的项目"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_glass_card"
        android:elevation="6dp"
        android:minHeight="72dp">

        <LinearLayout
            android:id="@+id/normalBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="72dp"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navHome"
                style="@style/BottomNavButton"
                android:text="主目录"
                app:icon="@drawable/ic_home" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navSdcard"
                style="@style/BottomNavButton"
                android:text="SDCard"
                app:icon="@drawable/ic_storage" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navRoot"
                style="@style/BottomNavButton"
                android:text="根目录"
                app:icon="@drawable/ic_root" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pasteBtn"
                style="@style/BottomNavButton"
                android:text="粘贴"
                app:backgroundTint="@color/primary_container"
                app:icon="@drawable/ic_paste" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/selectionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <TextView
                    android:id="@+id/selCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="✕"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/selCount"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="已选 0 项"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/selAll"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="全选"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/selCopy"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="复制"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/selCut"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="剪切"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/selZip"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="压缩"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/selDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="删除"
                    android:textColor="@color/danger"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/selMore"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="更多⋮"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </FrameLayout>
</LinearLayout>
