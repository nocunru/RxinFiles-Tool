<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        基础主题：所有变体都从它继承。

        为什么要拆出 Base —— style 在限定符目录（values-night）里是**同名替换而不是合并**，
        night 里直接重写 Theme.RouXin 会把下面这些 item 全部丢掉。
        拆一层之后，night 只需继承 Base 再补那两三条差异。

        windowBackground 给的是 drawable（渐变 + 光晕）而不是纯色：
        这是整套玻璃质感成立的前提 —— 半透明层必须有「底」可透。
    -->
    <style name="Theme.RouXin.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_app_backdrop</item>
        <item name="android:statusBarColor">@color/app_bg_top</item>
        <item name="android:navigationBarColor">@color/app_bg_bottom</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorSurface">@color/app_bg_top</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.RouXin" parent="Theme.RouXin.Base" />

    <style name="Theme.RouXin.Terminal" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">#FF0D1117</item>
        <item name="android:statusBarColor">#FF161B22</item>
        <item name="android:navigationBarColor">#FF161B22</item>
        <item name="colorPrimary">@color/primary</item>
    </style>

    <!-- 排序面板里的一行：整行可点，高度取 48dp（触控下限之上） -->
    <style name="SortRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">?selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="QuickActionButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">76dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingHorizontal">2dp</item>
        <item name="android:textSize">11sp</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconGravity">textTop</item>
        <item name="iconPadding">5dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconTint">@color/primary</item>
        <item name="strokeWidth">0dp</item>
        <item name="backgroundTint">@color/quick_action_surface</item>
    </style>

    <style name="BottomNavButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">2dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingHorizontal">2dp</item>
        <item name="android:textSize">10sp</item>
        <item name="cornerRadius">15dp</item>
        <item name="iconGravity">textTop</item>
        <item name="iconPadding">2dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconTint">@color/primary</item>
        <item name="strokeWidth">0dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <style name="TerminalKey">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:layout_marginHorizontal">2dp</item>
        <item name="android:background">@drawable/bg_dark_key</item>
        <item name="android:textColor">#FFC9D1D9</item>
        <item name="android:textSize">12sp</item>
    </style>

</resources>
